rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          .data.rol in ['admin', 'administrador'];
    }

    // ── usuarios ─────────────────────────────────────────────────────────
    // Cada usuario solo lee/edita su propio documento.
    // Los admins pueden leer todos los documentos (panel de gestión).
    // Nadie puede borrar desde el cliente.
    match /usuarios/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      // Al crear su propio doc, el usuario NO puede autoasignarse un rol
      // privilegiado: solo se permite 'cliente' (o sin rol). Los admins
      // se promueven luego vía Admin SDK / panel de gestión.
      allow create: if isOwner(userId) &&
                       (!('rol' in request.resource.data) ||
                        request.resource.data.rol == 'cliente');
      // El propietario puede actualizar su doc pero NO puede cambiar su propio rol
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['rol'])) ||
                       isAdmin();
      allow delete: if false;
    }

    // ── productos ─────────────────────────────────────────────────────────
    // Lectura pública (catálogo). Escritura SOLO vía Admin SDK (server.js).
    match /productos/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── contactos ─────────────────────────────────────────────────────────
    // Sin acceso directo desde el cliente.
    // Creación y lectura solo vía Admin SDK (server.js).
    match /contactos/{docId} {
      allow read, write: if false;
    }

    // ── bot_no_entendidos ─────────────────────────────────────────────────
    // Datos de analítica internos. Solo Admin SDK.
    match /bot_no_entendidos/{docId} {
      allow read, write: if false;
    }

    // ── catch-all: denegar todo lo demás ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
