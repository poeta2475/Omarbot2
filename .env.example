# ══════════════════════════════════════════════
# DEOSOLUCIONES — Variables de entorno
# Copia este archivo como .env y llena los valores
# ══════════════════════════════════════════════

# ── Servidor ──
PORT=3000
# IMPORTANTE: usar "development" en PC local, "production" en el servidor real
# En "production" el servidor bloquea accesos desde localhost
NODE_ENV=development

# ── Autenticación Admin ──
ADMIN_EMAIL=admin@deosoluciones.com
ADMIN_PASSWORD=CambiarEsto_MinMax16Chars!

# ── JWT ──
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga_de_al_menos_32_caracteres

# ── Firebase Service Account ──
# Opción A (recomendada para producción): pegar el contenido JSON completo aquí
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"deosoluciones-29141",...}
#
# Opción B (uso local): dejar esta línea comentada y colocar el archivo
# deosoluciones-29141-firebase-adminsdk-fbsvc-922ff09da1.json en la raíz del proyecto

# ── Resend (envío de correos) ──
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ── Correos que reciben los formularios de contacto ──
CONTACT_EMAIL_TO=omarsena2475@gmail.com

# ── CORS extra (opcional, para staging u otros dominios) ──
# CORS_ORIGIN=https://staging.deosoluciones.com
